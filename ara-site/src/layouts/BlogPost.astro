---
export interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
const { Content } = await Astro.slots.render("default");
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — Ara Desktop</title>
  {description && <meta name="description" content={description} />}
  <link rel="icon" type="image/png" href="/ara/favicon.png" />
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&family=JetBrains+Mono:wght@400;500&display=swap');
    :root {
      --bg: #08090a; --fg: #f7f8f8; --fg2: #d0d6e0; --fg3: #8a8f98; --fg4: #62666d;
      --accent: #7170ff; --bdr: rgba(255,255,255,0.08); --bdr-sub: rgba(255,255,255,0.05);
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family:'Inter',system-ui,-apple-system,sans-serif; background:var(--bg); color:var(--fg2); -webkit-font-smoothing:antialiased; line-height:1.8; }
    .wrap { max-width:720px; margin:0 auto; padding:60px 24px; }
    .bread { display:flex; align-items:center; gap:12px; margin-bottom:40px; font-size:14px; }
    .bread a { color:var(--fg3); text-decoration:none; }
    .bread a:hover { color:var(--fg); }
    .bread .sep { color:var(--fg4); }

    article h1 { font-size:32px; font-weight:600; letter-spacing:-.5px; line-height:1.2; color:var(--fg); margin-bottom:8px; }
    article .meta { font-size:13px; color:var(--fg4); font-family:'JetBrains Mono',monospace; margin-bottom:40px; }
    article h2 { font-size:20px; font-weight:500; color:var(--fg); margin:40px 0 16px; }
    article h3 { font-size:16px; font-weight:500; color:var(--fg); margin:32px 0 12px; }
    article p { font-size:15px; color:var(--fg2); margin-bottom:16px; }
    article code { font-family:'JetBrains Mono',monospace; font-size:13px; background:rgba(255,255,255,.04); border:1px solid var(--bdr-sub); padding:1px 5px; border-radius:4px; }
    article pre { background:var(--bg); border:1px solid var(--bdr); border-radius:8px; padding:16px; overflow-x:auto; margin:20px 0; }
    article pre code { background:none; border:none; padding:0; font-size:13px; line-height:1.6; }
    article ul { margin:12px 0 20px; padding-left:20px; }
    article li { font-size:15px; color:var(--fg2); margin-bottom:6px; }
    article hr { border:none; border-top:1px solid var(--bdr); margin:40px 0; }
    article a { color:var(--accent); }
    article img { max-width:100%; border-radius:8px; margin:20px 0; border:1px solid var(--bdr); }

    footer { text-align:center; padding:40px 24px 60px; font-size:12px; color:var(--fg4); }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="bread">
      <a href="/ara/">Ara</a>
      <span class="sep">/</span>
      <a href="/ara/blog/">博客</a>
      <span class="sep">/</span>
      <span style="color:var(--fg4)">{title}</span>
    </div>
    <article>
      <slot name="title" />
      <div class="meta">2026-07-29 · #Tauri #工程实践</div>
      <slot />
    </article>
  </div>
  <footer><p>Ara Desktop · MIT 协议</p></footer>
</body>
</html>
