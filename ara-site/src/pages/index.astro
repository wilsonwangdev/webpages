---
import Base from "../layouts/Base.astro";
---

<Base title="Ara Desktop">
  <main class="hero">
    <h1>Your Agent, <span>Native.</span></h1>
    <p class="tagline">一个桌面端优先的成长型 AI Agent 客户端。用 Tauri 构建。</p>
    <div class="ctas">
      <a class="btn primary" href="https://github.com/wilsonwangdev/ara-desktop/releases">下载 Ara →</a>
      <a class="btn" href="https://github.com/wilsonwangdev/ara-desktop">GitHub 仓库</a>
    </div>
  </main>

  <section>
    <h2>📝 最新文章</h2>
    <div class="posts">
      <a class="post-item" href="/ara/blog/">
        <div class="meta">2026-07-29</div>
        <h3>从零用 Tauri 构建 AI Agent 桌面端</h3>
        <p>为什么选 Tauri、与 Electron 的真实对比、embed 终端的 sidecar 方案。</p>
        <div class="tags"><span>Tauri</span><span>工程实践</span></div>
      </a>
    </div>
  </section>

  <section>
    <h2>⬇️ 下载</h2>
    <div class="dl-grid">
      <div class="dl-card"><div class="os">macOS · ARM</div><h3>Ara Desktop.dmg</h3></div>
      <div class="dl-card"><div class="os">macOS · x64</div><h3>Ara Desktop.dmg</h3></div>
      <div class="dl-card"><div class="os">Windows · x64</div><h3>Ara Desktop.msi</h3></div>
      <div class="dl-card"><div class="os">Linux · x64</div><h3>Ara Desktop.AppImage</h3></div>
    </div>
  </section>
</Base>

<style>
  .hero { text-align: center; padding: 100px 0 80px; }
  .hero h1 { font-size: clamp(36px,5vw,56px); font-weight:600; letter-spacing:-1.2px; line-height:1.1; color:var(--fg); margin-bottom:16px; }
  .hero h1 span { color:var(--accent); }
  .hero .tagline { font-size:18px; color:var(--fg3); max-width:520px; margin:0 auto 40px; }
  .ctas { display:flex; justify-content:center; gap:12px; flex-wrap:wrap; }
  .btn { padding:10px 28px; border-radius:6px; font-size:14px; font-weight:500; text-decoration:none; border:1px solid var(--bdr); color:var(--fg2); transition:all .15s; }
  .btn:hover { border-color:var(--fg4); color:var(--fg); }
  .btn.primary { background:var(--accent); border-color:var(--accent); color:#fff; }
  .btn.primary:hover { background:#828fff; }

  section { margin-bottom:80px; }
  section h2 { font-size:13px; font-weight:600; text-transform:uppercase; letter-spacing:.5px; color:var(--fg4); padding-bottom:12px; border-bottom:1px solid var(--bdr); margin-bottom:24px; }

  .posts { display:flex; flex-direction:column; }
  .post-item { padding:20px 0; border-bottom:1px solid var(--bdr-sub); text-decoration:none; color:inherit; transition:opacity .15s; }
  .post-item:hover { opacity:.85; }
  .post-item .meta { font-size:12px; color:var(--fg4); font-family:'JetBrains Mono',monospace; margin-bottom:4px; }
  .post-item h3 { font-size:17px; font-weight:500; color:var(--fg); margin-bottom:6px; }
  .post-item p { font-size:14px; color:var(--fg3); }
  .tags { display:flex; gap:6px; margin-top:8px; }
  .tags span { font-size:11px; font-weight:500; padding:2px 8px; border-radius:4px; background:rgba(255,255,255,.04); border:1px solid var(--bdr-sub); color:var(--fg4); }

  .dl-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:8px; }
  .dl-card { padding:16px; border:1px solid var(--bdr); border-radius:8px; transition:border-color .15s; }
  .dl-card:hover { border-color:var(--accent); }
  .dl-card .os { font-size:13px; font-weight:500; color:var(--fg4); font-family:'JetBrains Mono',monospace; }
  .dl-card h3 { font-size:15px; font-weight:500; color:var(--fg); margin-top:2px; }
  @media(max-width:640px) { .dl-grid { grid-template-columns:1fr; } }
</style>
